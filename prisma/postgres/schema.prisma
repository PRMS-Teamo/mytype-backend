generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/postgres-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}
model apply_history {
  team_position_id          String         @db.Uuid 
  user_id          String         @db.Uuid
  message          String?        @db.Text
  is_read          Boolean?       @default(false)
  reply            String?        @db.Text
  apply_status     apply_status?  @default(SUBMITTED)
  action           action
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @updatedAt @db.Timestamp(6)
  team_positions            team_positions          @relation(fields: [team_position_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_team_positions_TO_apply_history_1")
  users            users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_apply_history_1")

  @@id([user_id, team_position_id], map: "PK_APPLY_HISTORY")
}

model positions {
  id             String           @id(map: "PK_POSITIONS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(50)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @updatedAt @db.Timestamp(6)
  team_positions team_positions[]
  users          users[]
}

model stack_categories {
  id         String    @id(map: "PK_STACK_CATEGORIES") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String?   @db.VarChar(30)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6) @default(now())
  stacks     stacks[]
}

model stacks {
  id               String            @id(map: "PK_STACKS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id      String            @db.Uuid
  name             String?           @db.VarChar(50)
  img_url          String
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @updatedAt @db.Timestamp(6) @default(now())
  stack_categories stack_categories  @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_stack_categories_TO_stacks_1")
  position_stacks  position_stacks[]
  user_stacks      user_stacks[]
}

model team_positions {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id         String            @db.Uuid
  position_id     String            @db.Uuid
  recruit_status  recruit_status?   @default(OPEN)
  count           Int?              @default(1)
  status          Boolean
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @updatedAt @db.Timestamp(6) @default(now())
  teams           teams             @relation(fields: [team_id], references: [id])
  positions       positions         @relation(fields: [position_id], references: [id])
  team_users      team_users[]
  position_stacks position_stacks[]
  apply_history   apply_history[]
}

model position_stacks {
  team_position_id  String @db.Uuid
  stack_id String @db.Uuid

  team_positions team_positions @relation(fields: [team_position_id], references: [id])
  stacks         stacks         @relation(fields: [stack_id], references: [id])

  @@id([team_position_id, stack_id])
}

model team_users {
  user_id          String         @db.Uuid
  team_position_id String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_owner          Boolean?
  message          String?        @db.VarChar(3000)
  member_status    member_status? @default(ON_BOARD)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @updatedAt @db.Timestamp(6) @default(now())
  team_positions   team_positions @relation(fields: [team_position_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_team_stack_positions_TO_team_users_1")
  users            users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_team_users_1")

  @@id([user_id, team_position_id], map: "PK_TEAM_USERS")
}

model teams {
  id             String          @id(map: "PK_TEAMS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String?         @db.VarChar(100)
  content        String?         @db.VarChar(500)
  user_id        String?         @db.Uuid
  is_public      Boolean?
  location       String?         @db.VarChar(100)
  recruit_status recruit_status? @default(OPEN)
  proceed_type   proceed_type?   @default(ONLINE)
  img            String?
  start_date     DateTime?       @db.Timestamp(6)
  end_date       DateTime?       @db.Timestamp(6)
  start_time     DateTime?       @db.Timestamp(6)
  end_time       DateTime?       @db.Timestamp(6)
  meeting_location String?       @db.VarChar(100)
  meeting_link   String?       @db.VarChar(100)
  bumped_at      DateTime?       @default(now()) @db.Timestamp(6)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @updatedAt @db.Timestamp(6) @default(now())

  team_positions team_positions[]
  team_bumps     team_bumps[]
  chat_rooms     chat_rooms[]
}

model user_stacks {
  user_id    String    @db.Uuid
  stack_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6) @default(now())
  stacks     stacks    @relation(fields: [stack_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_stacks_TO_user_stacks_1")
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_user_stacks_1")

  @@id([user_id, stack_id], map: "PK_USER_STACKS")
}

model users {
  id                String              @id(map: "PK_USERS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position_id       String?             @db.Uuid
  role              roles?              @default(USER)
  name              String              @db.VarChar(50)
  nickname          String?             @db.VarChar(30)
  email             String?             @db.VarChar(100)
  hashed_refresh_token                 String?             @db.VarChar(200)
  github_id         String?             @db.VarChar(200)
  img_id            String?             @db.Uuid
  img_url           String?             @db.VarChar(200)
  address           String?             @db.VarChar(100)
  beginner          Boolean?            @default(false)
  join_status       Boolean?
  bumped_at         DateTime?           @default(now()) @db.Timestamp(6)
  create_at         DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @updatedAt @db.Timestamp(6) @default(now())
  description       String?             @db.VarChar(200)
  proceed_type      proceed_type?       @default(ONLINE)
  apply_history     apply_history[]
  team_users        team_users[]
  user_auths        user_auths[]
  positions         positions?          @relation(fields: [position_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_positions_TO_users_1")
  user_stacks       user_stacks[]
  preferred_meeting meetings?
  is_public         Boolean?
  chat_participants chat_participants[]
  user_bumps       user_bumps[]
  images           images?             @relation(fields: [img_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_images_TO_users_1")
}

model user_bumps {
  user_id String @db.Uuid
  bump_count Int @default(0)
  bump_limit Int @default(1)
  next_available_at DateTime?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6) @default(now())
  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_user_bumps_1")

  @@id([user_id], map: "PK_USER_BUMP")
}

model team_bumps {
  team_id String @db.Uuid
  bump_count Int @default(0)
  bump_limit Int @default(1)
  next_available_at DateTime?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6) @default(now())
  teams teams @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_teams_TO_team_bumps_1")

  @@id([team_id], map: "PK_TEAM_BUMP")
}


model user_auths {
  user_id      String       @db.Uuid
  auth_id      String       @db.Uuid
  external_id  String       @db.VarChar(100)
  access_token String? @db.VarChar(500)  
  refresh_token String? @db.VarChar(500) 
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at   DateTime?    @updatedAt @db.Timestamp(6) @default(now())
  auth_methods auth_methods @relation(fields: [auth_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_auth_methods_TO_user_auths_1")
  users        users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_user_auths_1")

  @@unique([user_id, auth_id], map: "PK_USER_AUTHS")
}

model auth_methods {
  id          String       @id(map: "PK_AUTH_METHODS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_method auth_method? @default(OAuth)
  provider    String       @db.VarChar(50)
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  updated_at  DateTime?    @updatedAt @db.Timestamp(6) @default(now())
  user_auths  user_auths[]
}

model chat_rooms {
  id                String              @id(map: "PK_CHAT_ROOMS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id           String              @db.Uuid
  inquery_id        String              @db.Uuid
  type              chat_room_type
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @updatedAt @db.Timestamp(6) @default(now())
  teams             teams               @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_teams_TO_chat_rooms_1")
  chat_participants chat_participants[]
}

model chat_participants {
  id         String     @id(map: "PK_CHAT_PARTICIPANTS") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id    String     @db.Uuid
  user_id    String     @db.Uuid
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @updatedAt @db.Timestamp(6) @default(now())
  chat_rooms chat_rooms @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_chat_rooms_TO_chat_participants_1")
  users      users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_TO_chat_participants_1")
}

model images {
  id           String   @id(map: "PK_IMAGES") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url          String   @db.VarChar(500)
  content_type String   @db.VarChar(50)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6) @default(now())
  users        users[]
}

enum chat_room_type {
  DM
  TEAM
  INQUERY
}

enum action {
  APPLY
  INVITE
}

enum apply_status {
  FAILED
  SUBMITTED
  CANCEL
  SUCCESS
  REJECTED
}

enum auth_method {
  OAuth
  Social
}

enum member_status {
  ON_BOARD
  OFF_BOARD
}

enum proceed_type {
  ONLINE
  OFFLINE
  BOTH
}

enum recruit_status {
  OPEN
  CLOSE
}

enum roles {
  USER
  ADMIN
  MASTER
}

enum meetings {
  ONLINE
  OFFLINE
  BOTH
}
