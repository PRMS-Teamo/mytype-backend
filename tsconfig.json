{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/infrastructure/config/*"],
      "@modules/*": ["src/modules/*"],
      "@common/*": ["src/apis/shared/common/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@utils/*": ["src/utils/*"],
      "@postgres-client": ["generated/postgres-client"],
      "@mongo-client": ["generated/mongo-client"]
    }
  },
  "include": [
    "src/**/*",
    "src/types/**/*",
    "generated/postgres-client",
    "generated/mongo-client",
    "prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "databases.init/mongo/init.js",
    "docs",
    "logs"
  ]
}
